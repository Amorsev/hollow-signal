  "hollowsignal.dialogue.see_me.friendly.0": "всегда. всё хорошо",
  "hollowsignal.dialogue.see_me.friendly.1": "да. ты выглядишь уставшим",
  "hollowsignal.dialogue.see_me.neutral.0": "да",
